*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
data/
queue/
logs/

# Environment and secrets
.env
.env.*

# OS noise
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/

# Test scratch output
test/tmp/
coverage/
